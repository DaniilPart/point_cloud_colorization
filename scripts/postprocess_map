#!/usr/bin/env bash

set -euo pipefail


usage() {
  echo "Usage: $0 [run_dir_or_input_map.ply]"
  echo
  echo "Runs the full map post-processing pipeline:"
  echo "  1) surfel generation"
  echo "  2) PLY -> LAS translation via PDAL"
  echo "  3) Potree web viewer generation"
  echo "  4) Zip archive for sharing"
  echo
  echo "Input can be either:"
  echo "  - a run directory containing colored_cloud_map.ply"
  echo "  - a direct .ply map path"
  echo "  - omitted (auto-select latest run map under \$POSTPROCESS_RUNS_ROOT)"
  echo
  echo "All outputs are written to a '3dmap' folder inside the run directory"
  echo "(or next to the input .ply when a direct file path is provided)."
  echo
  echo "Environment:"
  echo "  POSTPROCESS_RUNS_ROOT   Search root for auto-select mode (default: ~/sarmo/elrob)"
  echo "  NTFY_ENABLE             1 to enable notifications, 0 to disable (default: 1)"
  echo "  NTFY_SERVER             ntfy server URL (default: https://ntfy.sh)"
  echo "  NTFY_TOPIC              ntfy topic (default: sarmo)"
  echo "  NTFY_TOKEN              optional bearer token for authenticated ntfy servers"
}

NTFY_ENABLE="${NTFY_ENABLE:-1}"
NTFY_SERVER="${NTFY_SERVER:-https://ntfy.sh}"
NTFY_TOPIC="${NTFY_TOPIC:-sarmo}"
NTFY_TOKEN="${NTFY_TOKEN:-}"

notify_ntfy() {
  local title="$1"
  local priority="$2"
  local tags="$3"
  local body="$4"

  if [[ "$NTFY_ENABLE" == "0" || "$NTFY_ENABLE" == "false" || "$NTFY_ENABLE" == "False" ]]; then
    return 0
  fi

  if ! command -v curl >/dev/null 2>&1; then
    return 0
  fi

  local url="${NTFY_SERVER%/}/${NTFY_TOPIC}"
  local -a curl_args
  curl_args=(
    -sS
    -m 10
    -X POST
    -H "Title: $title"
    -H "Priority: $priority"
    -H "Tags: $tags"
    -d "$body"
    "$url"
  )

  if [[ -n "$NTFY_TOKEN" ]]; then
    curl_args+=( -H "Authorization: Bearer $NTFY_TOKEN" )
  fi

  curl "${curl_args[@]}" >/dev/null 2>&1 || true
}

on_error_notify() {
  local exit_code="$1"
  notify_ntfy \
    "Map postprocess failed" \
    "high" \
    "warning,rotating_light" \
    "Input: ${input_abs:-unknown}\nOutput dir: ${output_dir:-unknown}\nExit code: ${exit_code}"
}

trap 'on_error_notify "$?"' ERR

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -gt 1 ]]; then
  usage
  exit 2
fi

input_arg="${1:-}"

expand_tilde() {
  local p="$1"
  if [[ "$p" == ~* ]]; then
    echo "${p/#\~/$HOME}"
    return 0
  fi
  echo "$p"
}

resolve_latest_run_map() {
  local root="$1"

  if [[ ! -d "$root" ]]; then
    echo "Error: auto-select root does not exist: $root" >&2
    return 1
  fi

  local latest
  latest="$(
    (find "$root" -mindepth 2 -maxdepth 2 -type f -name 'colored_cloud_map.ply' -printf '%T@ %p\n' 2>/dev/null || true) |
    sort -n |
    tail -n 1 |
    cut -d' ' -f2-
  )"

  if [[ -z "$latest" ]]; then
    echo "Error: no colored_cloud_map.ply found under: $root" >&2
    return 1
  fi

  echo "$latest"
}

resolve_input_ply() {
  local arg="$1"

  if [[ -d "$arg" ]]; then
    local candidate="$arg/colored_cloud_map.ply"
    if [[ -f "$candidate" ]]; then
      echo "$candidate"
      return 0
    fi

    echo "Error: run directory does not contain colored_cloud_map.ply: $arg" >&2
    return 1
  fi

  if [[ ! -f "$arg" ]]; then
    echo "Error: input does not exist: $arg" >&2
    return 1
  fi

  case "$arg" in
    *.ply|*.PLY)
      echo "$arg"
      return 0
      ;;
    *)
      echo "Error: input file must be a .ply file, or provide a run directory." >&2
      return 1
      ;;
  esac
}

if [[ -z "$input_arg" ]]; then
  runs_root="${POSTPROCESS_RUNS_ROOT:-~/sarmo/elrob}"
  runs_root="$(expand_tilde "$runs_root")"
  input_arg="$(resolve_latest_run_map "$runs_root")" || exit 2
  echo "Auto-selected latest run map: $input_arg"
fi

input_ply="$(resolve_input_ply "$input_arg")" || exit 2

if ! command -v ros2 >/dev/null 2>&1; then
  echo "Error: ros2 command not found in PATH." >&2
  exit 3
fi

if ! command -v pdal >/dev/null 2>&1; then
  echo "Error: pdal command not found in PATH." >&2
  exit 3
fi

if ! command -v zip >/dev/null 2>&1; then
  echo "Error: zip command not found in PATH." >&2
  exit 3
fi

resolve_potree_converter() {
  if [[ -n "${POTREE_CONVERTER:-}" ]]; then
    if [[ -x "$POTREE_CONVERTER" ]]; then
      echo "$POTREE_CONVERTER"
      return 0
    fi
    echo "Error: POTREE_CONVERTER is set but not executable: $POTREE_CONVERTER" >&2
    return 1
  fi

  if command -v PotreeConverter >/dev/null 2>&1; then
    command -v PotreeConverter
    return 0
  fi

  local default_path="$HOME/potree_converter/PotreeConverter_linux_x64/PotreeConverter"
  if [[ -x "$default_path" ]]; then
    echo "$default_path"
    return 0
  fi

  echo "Error: PotreeConverter not found." >&2
  echo "Set POTREE_CONVERTER or install it at $default_path" >&2
  return 1
}

potree_converter_bin="$(resolve_potree_converter)"

input_abs="$(readlink -f "$input_ply")"
input_dir="$(dirname "$input_abs")"
input_name="$(basename "$input_abs")"
input_stem="${input_name%.*}"
run_id="$(basename "$input_dir")"

output_dir="$input_dir/3dmap"
surfel_ply="$output_dir/${input_stem}_surfels.ply"
surfel_las="$output_dir/${input_stem}_surfels.las"
package_root_name="sarmo_${run_id}"
maps_bundle_dir_name="maps_and_trajectories_${run_id}"
viz_bundle_dir_name="visualization_sarmo_${run_id}"
package_root_dir="$output_dir/$package_root_name"
maps_bundle_dir="$package_root_dir/$maps_bundle_dir_name"
viz_bundle_dir="$package_root_dir/$viz_bundle_dir_name"
potree_workspace="$viz_bundle_dir"
zip_path="$output_dir/${package_root_name}.zip"
export_root_default="/media/${USER}/sarmo/elrob"
export_root="${POSTPROCESS_EXPORT_ROOT:-$export_root_default}"
export_zip_path="$export_root/$(basename "$zip_path")"
zip_exported="false"

mkdir -p "$output_dir"
rm -rf "$package_root_dir"
rm -f "$zip_path"
mkdir -p "$maps_bundle_dir" "$viz_bundle_dir"

notify_ntfy \
  "Map postprocess started" \
  "default" \
  "hourglass_flowing_sand,triangular_flag_on_post" \
  "Input: $input_abs\nOutput dir: $output_dir"

echo "[1/4] Generating surfels"
ros2 run pointcloud_colorizer surfel_generator "$input_abs" "$surfel_ply"

echo "[2/4] Translating PLY to LAS"
pdal translate \
  "$surfel_ply" \
  "$surfel_las" \
  --writers.las.scale_x=0.001 \
  --writers.las.scale_y=0.001 \
  --writers.las.scale_z=0.001 \
  --writers.las.offset_x=auto \
  --writers.las.offset_y=auto \
  --writers.las.offset_z=auto

echo "[3/4] Generating Potree viewer"
"$potree_converter_bin" "$surfel_las" -o "$potree_workspace" --generate-page index

echo "[4/4] Creating zip archive"
cp -f "$input_abs" "$maps_bundle_dir/"
cp -f "$surfel_ply" "$maps_bundle_dir/"
cp -f "$surfel_las" "$maps_bundle_dir/"

for trajectory_file in \
  odometry.csv \
  ecef.csv \
  utm.csv \
  odom_earth_pose_log.csv \
  earth_to_odom_transform.yaml
do
  src_path="$input_dir/$trajectory_file"
  if [[ -f "$src_path" ]]; then
    cp -f "$src_path" "$maps_bundle_dir/"
  fi
done

(
  cd "$output_dir"
  zip -rq "$zip_path" "$package_root_name"
)

echo "[5/5] Exporting zip to removable media (best effort)"
if [[ -d "$export_root" ]]; then
  if cp -f "$zip_path" "$export_zip_path"; then
    zip_exported="true"
  else
    echo "Warning: failed to copy zip to $export_root" >&2
  fi
else
  echo "Info: export destination not found, skipping copy: $export_root"
fi

echo
echo "Input map: $input_abs"
echo "Pipeline complete. Outputs:"
echo "  - $surfel_ply"
echo "  - $surfel_las"
echo "  - $potree_workspace"
echo "  - $zip_path"
if [[ "$zip_exported" == "true" ]]; then
  echo "  - $export_zip_path"
fi

notify_ntfy \
  "Map postprocess complete" \
  "default" \
  "white_check_mark,package" \
  "Input: $input_abs\nSurfel PLY: $surfel_ply\nLAS: $surfel_las\nViewer: $potree_workspace\nZip: $zip_path\nExported zip: $zip_exported"